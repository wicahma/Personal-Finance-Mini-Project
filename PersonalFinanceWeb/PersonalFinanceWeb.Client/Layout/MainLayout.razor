@inherits LayoutComponentBase
@inject ICurrencyFormatterService CurrencyFormatter
@implements IDisposable

<div class="flex min-h-screen bg-base-bg">

    <aside class="w-64 flex-shrink-0 bg-base-surface border-r-2 border-base-border flex flex-col">

        <div class="px-6 py-5 border-b-2 border-base-border">
            <span class="text-xl font-black uppercase tracking-widest text-neon">
                FinanceOS
            </span>
        </div>

        <nav class="flex-1 py-4 flex flex-col gap-1">
            <NeubrutalistNavLink Href="/" Text="Dashboard" Match="NavLinkMatch.All">
                <Icon>
                    <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0h6" />
                    </svg>
                </Icon>
            </NeubrutalistNavLink>

            <NeubrutalistNavLink Href="/transactions" Text="Transactions">
                <Icon>
                    <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                    </svg>
                </Icon>
            </NeubrutalistNavLink>

            <NeubrutalistNavLink Href="/accounts" Text="Accounts">
                <Icon>
                    <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h.01M11 15h.01M21 6H3a2 2 0 00-2 2v8a2 2 0 002 2h18a2 2 0 002-2V8a2 2 0 00-2-2z" />
                    </svg>
                </Icon>
            </NeubrutalistNavLink>

            <NeubrutalistNavLink Href="/budgets" Text="Budgets">
                <Icon>
                    <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                    </svg>
                </Icon>
            </NeubrutalistNavLink>

            <NeubrutalistNavLink Href="/goals" Text="Goals">
                <Icon>
                    <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9" />
                    </svg>
                </Icon>
            </NeubrutalistNavLink>

            <NeubrutalistNavLink Href="/categories" Text="Categories">
                <Icon>
                    <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                    </svg>
                </Icon>
            </NeubrutalistNavLink>

            <NeubrutalistNavLink Href="/tags" Text="Tags">
                <Icon>
                    <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                    </svg>
                </Icon>
            </NeubrutalistNavLink>
        </nav>

        <div class="px-4 pb-6 border-t-2 border-base-border pt-4">
            <AuthorizeView>
                <Authorized>
                    <div class="flex items-center gap-3 mb-3">
                        <a href="/profile"
                           class="w-8 h-8 border-2 border-neon flex items-center justify-center hover:shadow-brutal-green transition-all duration-100">
                            <span class="text-neon font-black text-sm">
                                @(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                            </span>
                        </a>
                        <a href="/profile" class="text-xs text-gray-400 font-semibold truncate hover:text-neon transition-colors">
                            @context.User.Identity?.Name
                        </a>
                    </div>
                    <div class="flex items-center gap-4">
                        <a href="/profile"
                           class="text-xs font-bold uppercase tracking-widest text-gray-500 hover:text-neon transition-colors">
                            Profile
                        </a>
                        <form action="Account/Logout" method="post" class="inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="Account/Login" />
                        <button type="submit"
                                class="text-xs font-bold uppercase tracking-widest text-gray-500 hover:text-hot-pink transition-colors bg-transparent border-none p-0 cursor-pointer">
                            Logout
                        </button>
                    </form>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
    </aside>

    <main class="flex-1 overflow-auto p-8">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await CurrencyFormatter.InitializeAsync();
        CurrencyFormatter.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        CurrencyFormatter.OnChange -= StateHasChanged;
    }
}
