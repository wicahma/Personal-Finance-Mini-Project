
<button type="@Type"
        disabled="@Disabled"
        class="@ComputedClass"
        @onclick="OnClick">
    @if (IconLeft is not null)
    {
        @IconLeft
    }
    <span>@Text</span>
    @if (IconRight is not null)
    {
        @IconRight
    }
</button>

@code {
    public enum ButtonVariant { Primary, Secondary, Danger, Ghost }

    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? ExtraClass { get; set; }
    [Parameter] public RenderFragment? IconLeft { get; set; }
    [Parameter] public RenderFragment? IconRight { get; set; }

    private string ComputedClass => string.Join(" ", new[]
    { 
        "inline-flex items-center gap-2 px-5 py-2.5",
        "font-bold text-sm tracking-wide uppercase",
        "border-2 border-black",
        "transition-all duration-100 ease-in-out",
        "active:translate-x-[2px] active:translate-y-[2px]",
        Disabled ? "cursor-not-allowed opacity-50" : "cursor-pointer hover:-translate-y-0.5 hover:-translate-x-0.5",
        VariantClass,
        ExtraClass ?? string.Empty
    }.Where(s => !string.IsNullOrWhiteSpace(s)));

    private string VariantClass => Variant switch
    {
        ButtonVariant.Primary   => "bg-neon text-black shadow-brutal-yellow hover:shadow-brutal-yellow active:shadow-none",
        ButtonVariant.Secondary => "bg-vivid-yellow text-black shadow-brutal-green hover:shadow-brutal-green active:shadow-none",
        ButtonVariant.Danger    => "bg-hot-pink text-white shadow-brutal-white hover:shadow-brutal-white active:shadow-none",
        ButtonVariant.Ghost     => "bg-transparent text-soft-white border-base-border shadow-brutal-white hover:shadow-brutal-white active:shadow-none hover:border-soft-white",
        _                       => string.Empty
    };
}
