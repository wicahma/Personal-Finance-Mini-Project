@page "/accounts"
@rendermode InteractiveAuto
@attribute [Authorize]

@inject IAccountClientService AccountService

<PageTitle>Accounts — FinanceOS</PageTitle>

<div class="space-y-8">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-4xl font-black uppercase tracking-tight text-soft-white">Accounts</h1>
            <p class="text-gray-400 mt-1 text-sm font-medium tracking-wider">
                Manage wallets, banks, and cash funds
            </p>
        </div>

        <div class="flex items-center gap-3">
            <button @onclick="ToggleShowArchived"
                    class="@ToggleClass">
                @(_showArchived ? "Hide Archived" : "Show Archived")
            </button>

            <NeubrutalistButton Text="+ New Account"
                                Variant="NeubrutalistButton.ButtonVariant.Primary"
                                OnClick="OpenCreateModal" />
        </div>
    </div>

    @if (_loading)
    {
        <div class="flex items-center gap-3 text-gray-400">
            <svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
            </svg>
            <span class="text-sm font-semibold uppercase tracking-widest">Loading accounts…</span>
        </div>
    }
    else
    {
        @if (_pageError is not null)
        {
            <NeubrutalistAlert Severity="NeubrutalistAlert.AlertSeverity.Error"
                               Message="@_pageError" />
        }

        @if (!FilteredAccounts.Any())
        {
            <div class="border-2 border-dashed border-base-border p-12 text-center">
                <p class="text-gray-500 text-lg font-bold uppercase tracking-widest">No accounts found</p>
                <p class="text-gray-600 text-sm mt-2">
                    @if (_showArchived)
                    {
                        <span>No archived accounts.</span>
                    }
                    else
                    {
                        <span>Create your first account to start tracking finances.</span>
                    }
                </p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
        @foreach (var account in FilteredAccounts)
        {
            <div class="bg-base-surface border-2 p-5 flex flex-col gap-4 @(account.IsArchived ? "opacity-60" : "")"
                 style="border-color: @TypeColor(account.Type); box-shadow: 4px 4px 0px @TypeColor(account.Type);">

                <div class="flex items-start justify-between gap-2">
                    <div class="flex-1 min-w-0">
                        <h3 class="font-black text-soft-white text-lg leading-tight truncate"
                            title="@account.Name">
                            @account.Name
                        </h3>
                        @if (account.IsArchived)
                        {
                            <span class="inline-block mt-1 border border-gray-600 px-2 py-0 text-gray-500 text-xs font-bold uppercase tracking-widest">
                                ARCHIVED
                            </span>
                        }
                    </div>
                    <span class="shrink-0 border-2 px-2 py-0.5 text-xs font-black tracking-widest"
                          style="border-color: @TypeColor(account.Type); color: @TypeColor(account.Type); box-shadow: 2px 2px 0px @TypeColor(account.Type);">
                        @TypeLabel(account.Type)
                    </span>
                </div>

                <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-1">Balance</p>
                    <p class="font-black text-3xl" style="color: @TypeColor(account.Type);">
                        @account.CurrentBalance.ToString("N2")
                    </p>
                </div>

                <div class="flex items-center justify-between border-t border-base-border pt-3 mt-auto">
                    <span class="text-xs text-gray-500 font-semibold">
                        @TypeDesc(account.Type) · @account.CreatedAt.ToString("MMM d, yyyy")
                    </span>

                    <div class="flex items-center gap-2">
                        @if (!account.IsArchived)
                        {
                            <button @onclick="() => OpenEditModal(account)"
                                    class="text-xs font-bold uppercase tracking-widest border-2 border-base-border px-3 py-1
                                           text-gray-400 hover:border-vivid-yellow hover:text-vivid-yellow transition-colors">
                                Edit
                            </button>
                            <button @onclick="() => OpenAdjustModal(account)"
                                    class="text-xs font-bold uppercase tracking-widest border-2 border-base-border px-3 py-1
                                           text-gray-400 hover:border-hot-pink hover:text-hot-pink transition-colors">
                                Adjust
                            </button>
                        }

                        @if (account.IsArchived)
                        {
                            <button @onclick="() => UnarchiveAccount(account)"
                                    disabled="@(_archivingId == account.Id)"
                                    class="text-xs font-bold uppercase tracking-widest border-2 border-base-border px-3 py-1
                                           text-soft-white hover:border-neon hover:text-neon transition-colors
                                           disabled:opacity-40 disabled:cursor-not-allowed">
                                @(_archivingId == account.Id ? "…" : "Unarchive")
                            </button>
                        }
                        else
                        {
                            <button @onclick="() => ArchiveAccount(account)"
                                    disabled="@(_archivingId == account.Id)"
                                    class="text-xs font-bold uppercase tracking-widest border-2 border-base-border px-3 py-1
                                           text-gray-500 hover:border-hot-pink hover:text-hot-pink transition-colors
                                           disabled:opacity-40 disabled:cursor-not-allowed">
                                @(_archivingId == account.Id ? "…" : "Archive")
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
            </div>
        }

        @if (ActiveAccounts.Any())
        {
            <div class="border-t-2 border-base-border pt-6 grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="border-2 border-neon p-4 shadow-brutal-green">
                    <p class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-1">Net Worth</p>
                    <p class="text-2xl font-black text-neon">@TotalBalance.ToString("N2")</p>
                </div>
                <div class="border-2 p-4" style="border-color: #06B6D4; box-shadow: 4px 4px 0px #06B6D4;">
                    <p class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-1">Bank Total</p>
                    <p class="text-2xl font-black" style="color: #06B6D4;">@BankBalance.ToString("N2")</p>
                </div>
                <div class="border-2 p-4" style="border-color: #84CC16; box-shadow: 4px 4px 0px #84CC16;">
                    <p class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-1">Cash / eWallet</p>
                    <p class="text-2xl font-black" style="color: #84CC16;">@LiquidBalance.ToString("N2")</p>
                </div>
            </div>
        }
    }
</div>

@if (_showAdjustModal && _adjustingAccount is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4"
         style="background: rgba(0,0,0,0.85);"
         @onclick="CloseAdjustModal">

        <div class="bg-base-surface border-2 border-hot-pink w-full max-w-md p-6 space-y-6"
             style="box-shadow: 4px 4px 0px #FF2D78;"
             @onclick:stopPropagation="true">

            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-2xl font-black uppercase tracking-tight text-soft-white">Adjust Balance</h2>
                    <p class="text-xs text-gray-500 mt-0.5 font-medium">@_adjustingAccount.Name</p>
                </div>
                <button @onclick="CloseAdjustModal"
                        class="text-gray-500 hover:text-hot-pink font-black text-xl leading-none transition-colors">
                    ✕
                </button>
            </div>

            @if (_adjustError is not null)
            {
                <NeubrutalistAlert Severity="NeubrutalistAlert.AlertSeverity.Error"
                                   Message="@_adjustError" />
            }

            <div class="space-y-5">

                @* Current balance *@
                <div class="border-2 border-base-border p-4 flex items-center justify-between">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-1">Current Balance</p>
                        <p class="text-2xl font-black" style="color: @TypeColor(_adjustingAccount.Type);">
                            @_adjustingAccount.CurrentBalance.ToString("N2")
                        </p>
                    </div>
                    <span class="border-2 px-2 py-0.5 text-xs font-black tracking-widest"
                          style="border-color: @TypeColor(_adjustingAccount.Type); color: @TypeColor(_adjustingAccount.Type);">
                        @TypeLabel(_adjustingAccount.Type)
                    </span>
                </div>

                @* New target balance *@
                <div class="flex flex-col gap-1">
                    <label class="text-xs font-bold uppercase tracking-widest text-soft-white">New Balance</label>
                    <input type="number"
                           step="0.01"
                           value="@_adjustTarget"
                           @oninput="@(e => { if (decimal.TryParse(e.Value?.ToString(), out var v)) _adjustTarget = v; })"
                           placeholder="@_adjustingAccount.CurrentBalance.ToString("N2")"
                           class="w-full bg-base-bg text-soft-white border-2 border-base-border px-4 py-2.5
                                  font-medium placeholder:text-gray-600 focus:outline-none focus:border-hot-pink
                                  transition-colors duration-100" />
                </div>

                @* Live diff preview *@
                @{
                    var adjDiff = _adjustTarget - _adjustingAccount.CurrentBalance;
                }
                @if (adjDiff != 0m)
                {
                    <div class="border-2 p-3 @(adjDiff > 0 ? "border-neon" : "border-hot-pink")">
                        <p class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-1">Adjustment to be created</p>
                        <p class="font-black text-lg @(adjDiff > 0 ? "text-neon" : "text-hot-pink")">
                            @(adjDiff > 0 ? "+" : "")@adjDiff.ToString("N2")
                            <span class="text-xs font-semibold ml-2 @(adjDiff > 0 ? "text-neon" : "text-hot-pink")">
                                @(adjDiff > 0 ? "INCOME" : "EXPENSE")
                            </span>
                        </p>
                        <p class="text-xs text-gray-500 mt-0.5">Notes: "Balance Adjustment"</p>
                    </div>
                }
                else if (_adjustTarget == _adjustingAccount.CurrentBalance)
                {
                    <p class="text-xs text-gray-500 font-semibold">No change — balance is already @_adjustingAccount.CurrentBalance.ToString("N2").</p>
                }

            </div>

            <div class="flex gap-3 pt-2">
                <NeubrutalistButton Text="@(_adjusting ? "Applying…" : "Apply Adjustment")"
                                    Variant="NeubrutalistButton.ButtonVariant.Danger"
                                    Disabled="@(_adjusting || adjDiff == 0m)"
                                    OnClick="HandleAdjust" />
                <NeubrutalistButton Text="Cancel"
                                    Variant="NeubrutalistButton.ButtonVariant.Ghost"
                                    OnClick="CloseAdjustModal" />
            </div>
        </div>
    </div>
}

@if (_showEditModal && _editingAccount is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4"
         style="background: rgba(0,0,0,0.85);"
         @onclick="CloseEditModal">

        <div class="bg-base-surface border-2 border-vivid-yellow w-full max-w-md p-6 space-y-6"
             style="box-shadow: 4px 4px 0px #FACC15;"
             @onclick:stopPropagation="true">

            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-2xl font-black uppercase tracking-tight text-soft-white">Edit Account</h2>
                    <p class="text-xs text-gray-500 mt-0.5 font-medium">
                        Type: <span class="font-bold" style="color: @TypeColor(_editingAccount.Type);">@TypeLabel(_editingAccount.Type)</span>
                        &nbsp;·&nbsp; Cannot be changed after creation.
                    </p>
                </div>
                <button @onclick="CloseEditModal"
                        class="text-gray-500 hover:text-hot-pink font-black text-xl leading-none transition-colors">
                    ✕
                </button>
            </div>

            @if (_editError is not null)
            {
                <NeubrutalistAlert Severity="NeubrutalistAlert.AlertSeverity.Error"
                                   Message="@_editError" />
            }

            <div class="space-y-5">

                <NeubrutalistInput Label="Account Name"
                                   Value="@_editForm.Name"
                                   ValueChanged="@(v => _editForm.Name = v)"
                                   Placeholder="Account name"
                                   Error="@_editNameError" />

                @* Read-only current balance display *@
                <div class="border-2 border-base-border p-4">
                    <p class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-1">Current Balance</p>
                    <p class="text-2xl font-black" style="color: @TypeColor(_editingAccount.Type);">
                        @_editingAccount.CurrentBalance.ToString("N2")
                    </p>
                    <p class="text-xs text-gray-600 mt-1">
                        Balance is updated automatically via transactions.
                    </p>
                </div>

            </div>

            <div class="flex gap-3 pt-2">
                <NeubrutalistButton Text="@(_editing ? "Saving…" : "Save Changes")"
                                    Variant="NeubrutalistButton.ButtonVariant.Secondary"
                                    Disabled="@_editing"
                                    OnClick="HandleEdit" />
                <NeubrutalistButton Text="Cancel"
                                    Variant="NeubrutalistButton.ButtonVariant.Ghost"
                                    OnClick="CloseEditModal" />
            </div>
        </div>
    </div>
}

@if (_showCreateModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4"
         style="background: rgba(0,0,0,0.85);"
         @onclick="CloseCreateModal">

        <div class="bg-base-surface border-2 border-neon shadow-brutal-green w-full max-w-md p-6 space-y-6"
             @onclick:stopPropagation="true">

            <div class="flex items-center justify-between">
                <h2 class="text-2xl font-black uppercase tracking-tight text-soft-white">New Account</h2>
                <button @onclick="CloseCreateModal"
                        class="text-gray-500 hover:text-hot-pink font-black text-xl leading-none transition-colors">
                    ✕
                </button>
            </div>

            @if (_createError is not null)
            {
                <NeubrutalistAlert Severity="NeubrutalistAlert.AlertSeverity.Error"
                                   Message="@_createError" />
            }

            <div class="space-y-5">

                <NeubrutalistInput Label="Account Name"
                                   Value="@_form.Name"
                                   ValueChanged="@(v => _form.Name = v)"
                                   Placeholder="e.g. Surakarta Commute Fund"
                                   Error="@_nameError" />

                <div class="flex flex-col gap-1">
                    <label class="text-xs font-bold uppercase tracking-widest text-soft-white">
                        Account Type
                    </label>
                    <select value="@_form.Type"
                            @onchange="@(e => _form.Type = e.Value?.ToString() ?? "Bank")"
                            class="w-full bg-base-bg text-soft-white border-2 border-base-border px-4 py-2.5
                                   font-medium focus:outline-none focus:border-neon transition-colors
                                   duration-100 appearance-none">
                        <option value="Bank"    style="background:#111;color:#fff;">🏦 Bank — Salary deposits &amp; bills</option>
                        <option value="EWallet" style="background:#111;color:#fff;">📱 eWallet — Everyday digital payments</option>
                        <option value="Cash"    style="background:#111;color:#fff;">💵 Cash — Physical cash &amp; commute funds</option>
                    </select>
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-xs font-bold uppercase tracking-widest text-soft-white">
                        Initial Balance
                        <span class="text-gray-500 ml-1 normal-case font-medium">(optional)</span>
                    </label>
                    <input type="number"
                           min="0"
                           step="0.01"
                           value="@_form.InitialBalance"
                           @oninput="@(e => { if (decimal.TryParse(e.Value?.ToString(), out var v)) _form.InitialBalance = v; })"
                           placeholder="0.00"
                           class="w-full bg-base-bg text-soft-white border-2 border-base-border px-4 py-2.5
                                  font-medium placeholder:text-gray-600 focus:outline-none focus:border-neon
                                  transition-colors duration-100" />
                    <p class="text-xs text-gray-500">
                        A ledger transaction will be auto-created to record the opening balance.
                    </p>
                </div>

            </div>

            <div class="flex gap-3 pt-2">
                <NeubrutalistButton Text="@(_creating ? "Creating…" : "Create Account")"
                                    Variant="NeubrutalistButton.ButtonVariant.Primary"
                                    Disabled="@_creating"
                                    OnClick="HandleCreate" />
                <NeubrutalistButton Text="Cancel"
                                    Variant="NeubrutalistButton.ButtonVariant.Ghost"
                                    OnClick="CloseCreateModal" />
            </div>
        </div>
    </div>
}

@code {
    private List<AccountModel> _accounts = [];
    private bool _loading = true;
    private bool _showArchived;
    private string? _pageError;

    // Create modal state
    private bool _showCreateModal;
    private bool _creating;
    private string? _createError;
    private string? _nameError;
    private CreateAccountRequest _form = new();

    // Edit modal state
    private bool _showEditModal;
    private bool _editing;
    private string? _editError;
    private string? _editNameError;
    private AccountModel? _editingAccount;
    private UpdateAccountRequest _editForm = new();

    // Adjust balance modal state
    private bool _showAdjustModal;
    private bool _adjusting;
    private string? _adjustError;
    private AccountModel? _adjustingAccount;
    private decimal _adjustTarget;

    // Archive/unarchive in-progress
    private Guid? _archivingId;

    private IEnumerable<AccountModel> ActiveAccounts =>
        _accounts.Where(a => !a.IsArchived);

    private IEnumerable<AccountModel> FilteredAccounts =>
        _showArchived ? _accounts : ActiveAccounts;

    private string ToggleClass =>
        "px-4 py-2 text-xs font-bold uppercase tracking-widest border-2 transition-colors duration-100 " +
        (_showArchived
            ? "border-vivid-yellow text-vivid-yellow hover:bg-vivid-yellow hover:text-black"
            : "border-base-border text-gray-400 hover:border-soft-white hover:text-soft-white");

    private static string TypeColor(string type) => type switch
    {
        "Bank"    => "#06B6D4",
        "Cash"    => "#84CC16",
        "EWallet" => "#FACC15",
        _         => "#FFFFFF"
    };

    private static string TypeLabel(string type) => type switch
    {
        "Bank"    => "BANK",
        "Cash"    => "CASH",
        "EWallet" => "E-WALLET",
        _         => type.ToUpper()
    };

    private static string TypeDesc(string type) => type switch
    {
        "Bank"    => "Banking",
        "Cash"    => "Cash",
        "EWallet" => "eWallet",
        _         => type
    };

    private decimal TotalBalance  => ActiveAccounts.Sum(a => a.CurrentBalance);
    private decimal BankBalance   => ActiveAccounts.Where(a => a.Type == "Bank").Sum(a => a.CurrentBalance);
    private decimal LiquidBalance => ActiveAccounts.Where(a => a.Type is "Cash" or "EWallet").Sum(a => a.CurrentBalance);

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
    }

    private async Task LoadAccountsAsync()
    {
        _loading = true;
        _pageError = null;
        try
        {
            var result = await AccountService.GetAccountsAsync();
            _accounts = result.OrderBy(a => a.IsArchived).ThenBy(a => a.Name).ToList();
        }
        catch (Exception ex)
        {
            _pageError = $"Failed to load accounts: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void ToggleShowArchived() => _showArchived = !_showArchived;

    private void OpenCreateModal()
    {
        _form = new CreateAccountRequest();
        _createError = null;
        _nameError = null;
        _showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        _showCreateModal = false;
        _createError = null;
        _nameError = null;
    }

    private void OpenEditModal(AccountModel account)
    {
        _editingAccount = account;
        _editForm = new UpdateAccountRequest { Name = account.Name, IsArchived = account.IsArchived };
        _editError = null;
        _editNameError = null;
        _showEditModal = true;
    }

    private void CloseEditModal()
    {
        _showEditModal = false;
        _editingAccount = null;
        _editError = null;
        _editNameError = null;
    }

    private void OpenAdjustModal(AccountModel account)
    {
        _adjustingAccount = account;
        _adjustTarget = account.CurrentBalance;
        _adjustError = null;
        _showAdjustModal = true;
    }

    private void CloseAdjustModal()
    {
        _showAdjustModal = false;
        _adjustingAccount = null;
        _adjustError = null;
    }

    private async Task HandleAdjust()
    {
        if (_adjustingAccount is null) return;
        if (_adjustTarget == _adjustingAccount.CurrentBalance) return;

        _adjusting = true;
        _adjustError = null;
        try
        {
            var ok = await AccountService.AdjustBalanceAsync(
                _adjustingAccount.Id,
                _adjustingAccount.CurrentBalance,
                _adjustTarget);

            if (ok)
            {
                CloseAdjustModal();
                await LoadAccountsAsync();
            }
            else
            {
                _adjustError = "Adjustment failed. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _adjustError = ex.Message;
        }
        finally
        {
            _adjusting = false;
        }
    }

    private async Task HandleEdit()
    {
        _editNameError = null;
        _editError = null;

        if (string.IsNullOrWhiteSpace(_editForm.Name))
        {
            _editNameError = "Account name is required.";
            return;
        }

        if (_editingAccount is null) return;

        _editing = true;
        try
        {
            var result = await AccountService.UpdateAccountAsync(_editingAccount.Id, _editForm);
            if (result is not null)
            {
                var idx = _accounts.FindIndex(a => a.Id == result.Id);
                if (idx >= 0) _accounts[idx] = result;
                _accounts = _accounts.OrderBy(a => a.IsArchived).ThenBy(a => a.Name).ToList();
                CloseEditModal();
            }
            else
            {
                _editError = "Failed to save changes. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _editError = ex.Message;
        }
        finally
        {
            _editing = false;
        }
    }

    private async Task HandleCreate()
    {
        _nameError = null;
        _createError = null;

        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            _nameError = "Account name is required.";
            return;
        }

        if (_form.InitialBalance < 0)
        {
            _createError = "Initial balance cannot be negative.";
            return;
        }

        _creating = true;
        try
        {
            var result = await AccountService.CreateAccountAsync(_form);
            if (result is not null)
            {
                _accounts.Add(result);
                _accounts = _accounts.OrderBy(a => a.IsArchived).ThenBy(a => a.Name).ToList();
                CloseCreateModal();
            }
            else
            {
                _createError = "Failed to create account. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _createError = ex.Message;
        }
        finally
        {
            _creating = false;
        }
    }

    private async Task ArchiveAccount(AccountModel account)
    {
        _archivingId = account.Id;
        try
        {
            var ok = await AccountService.ArchiveAccountAsync(account.Id);
            if (ok)
            {
                var idx = _accounts.FindIndex(a => a.Id == account.Id);
                if (idx >= 0)
                {
                    _accounts[idx] = new AccountModel
                    {
                        Id = account.Id,
                        Name = account.Name,
                        Type = account.Type,
                        CurrentBalance = account.CurrentBalance,
                        IsArchived = true,
                        CreatedAt = account.CreatedAt,
                        UpdatedAt = DateTime.UtcNow
                    };
                }
            }
        }
        catch { /* swallow — optimistic UI already unchanged */ }
        finally
        {
            _archivingId = null;
        }
    }

    private async Task UnarchiveAccount(AccountModel account)
    {
        _archivingId = account.Id;
        try
        {
            var req = new UpdateAccountRequest { Name = account.Name, IsArchived = false };
            var result = await AccountService.UpdateAccountAsync(account.Id, req);
            if (result is not null)
            {
                var idx = _accounts.FindIndex(a => a.Id == account.Id);
                if (idx >= 0) _accounts[idx] = result;
            }
        }
        catch { }
        finally
        {
            _archivingId = null;
        }
    }
}
