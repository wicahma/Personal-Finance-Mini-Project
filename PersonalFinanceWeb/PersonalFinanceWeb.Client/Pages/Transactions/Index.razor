@page "/transactions"
@rendermode InteractiveAuto
@attribute [Authorize]

@inject ITransactionClientService TransactionService
@inject IAccountClientService AccountService
@inject ICategoryClientService CategoryService
@inject ITagClientService TagService

<PageTitle>Transactions — FinanceOS</PageTitle>

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
        <div>
            <h1 class="text-4xl font-black uppercase tracking-tight text-soft-white">Transactions</h1>
            <p class="text-gray-400 mt-1 text-sm font-medium tracking-wider">
                Track every income, expense, and transfer
            </p>
        </div>
        <NeubrutalistButton Text="+ Add Transaction"
                            Variant="NeubrutalistButton.ButtonVariant.Primary"
                            OnClick="OpenCreateModal" />
    </div>

    <div class="border-2 border-base-border bg-base-surface p-4 space-y-4"
         style="box-shadow: 4px 4px 0px #FFFFFF;">

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">

            <div class="flex flex-col gap-1">
                <label class="text-xs font-bold uppercase tracking-widest text-gray-400">From Date</label>
                <input type="date"
                       @bind="_filter.StartDate" @bind:format="yyyy-MM-dd"
                       class="w-full bg-base-bg text-soft-white border-2 border-base-border px-3 py-2
                              text-sm font-medium focus:outline-none focus:border-neon transition-colors [color-scheme:dark]" />
            </div>

            <div class="flex flex-col gap-1">
                <label class="text-xs font-bold uppercase tracking-widest text-gray-400">To Date</label>
                <input type="date"
                       @bind="_filter.EndDate" @bind:format="yyyy-MM-dd"
                       class="w-full bg-base-bg text-soft-white border-2 border-base-border px-3 py-2
                              text-sm font-medium focus:outline-none focus:border-neon transition-colors [color-scheme:dark]" />
            </div>

            <div class="flex flex-col gap-1">
                <label class="text-xs font-bold uppercase tracking-widest text-gray-400">Account</label>
                <select @bind="_filterAccountIdStr"
                        class="w-full bg-base-bg text-soft-white border-2 border-base-border px-3 py-2
                               text-sm font-medium focus:outline-none focus:border-neon transition-colors appearance-none">
                    <option value="">All accounts</option>
                    @foreach (var acc in _accounts.Where(a => !a.IsArchived))
                    {
                        <option value="@acc.Id">@acc.Name</option>
                    }
                </select>
            </div>

            <div class="flex flex-col gap-1">
                <label class="text-xs font-bold uppercase tracking-widest text-gray-400">Category</label>
                <select @bind="_filterCategoryIdStr"
                        class="w-full bg-base-bg text-soft-white border-2 border-base-border px-3 py-2
                               text-sm font-medium focus:outline-none focus:border-neon transition-colors appearance-none">
                    <option value="">All categories</option>
                    @foreach (var cat in _categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>
            </div>

            <div class="flex flex-col gap-1">
                <label class="text-xs font-bold uppercase tracking-widest text-gray-400">Tag</label>
                <select @bind="_filterTagIdStr"
                        class="w-full bg-base-bg text-soft-white border-2 border-base-border px-3 py-2
                               text-sm font-medium focus:outline-none focus:border-neon transition-colors appearance-none">
                    <option value="">All tags</option>
                    @foreach (var tag in _tags)
                    {
                        <option value="@tag.Id">@tag.Name</option>
                    }
                </select>
            </div>

        </div>

        <div class="flex gap-3">
            <NeubrutalistButton Text="Apply Filters"
                                Variant="NeubrutalistButton.ButtonVariant.Primary"
                                OnClick="ApplyFilters" />
            <NeubrutalistButton Text="Clear"
                                Variant="NeubrutalistButton.ButtonVariant.Ghost"
                                OnClick="ClearFilters" />
        </div>
    </div>

    @if (_pageError is not null)
    {
        <NeubrutalistAlert Severity="NeubrutalistAlert.AlertSeverity.Error" Message="@_pageError" />
    }

    @if (_loading)
    {
        <div class="flex items-center gap-3 text-gray-400 py-8">
            <svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
            </svg>
            <span class="text-sm font-semibold uppercase tracking-widest">Loading transactions…</span>
        </div>
    }
    else
    {
        @if (!_transactions.Any())
        {
            <div class="border-2 border-dashed border-base-border p-12 text-center">
                <p class="text-gray-500 text-lg font-bold uppercase tracking-widest">No transactions found</p>
                <p class="text-gray-600 text-sm mt-2">Log your first transaction or adjust your filters.</p>
            </div>
        }
        else
        {
            <div class="border-2 border-base-border overflow-x-auto"
                 style="box-shadow: 4px 4px 0px #FFFFFF;">
                <table class="w-full min-w-[700px]">
                    <thead>
                        <tr class="border-b-2 border-base-border bg-base-surface">
                            <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-widest text-gray-400 w-28">Date</th>
                            <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-widest text-gray-400">Account</th>
                            <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-widest text-gray-400">Category</th>
                            <th class="px-4 py-3 text-right text-xs font-black uppercase tracking-widest text-gray-400">Amount</th>
                            <th class="px-4 py-3 text-center text-xs font-black uppercase tracking-widest text-gray-400 w-28">Type</th>
                            <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-widest text-gray-400">Tags</th>
                            <th class="px-4 py-3 text-right text-xs font-black uppercase tracking-widest text-gray-400 w-28">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tx in _transactions)
                        {
                            <tr class="border-b-2 border-base-border hover:bg-white/5 transition-colors">

                                <td class="px-4 py-3">
                                    <span class="text-sm font-mono font-bold text-gray-300">
                                        @tx.Date.ToString("MMM dd")
                                    </span>
                                    <span class="block text-xs text-gray-500">
                                        @tx.Date.Year
                                    </span>
                                </td>

                                <td class="px-4 py-3">
                                    <span class="text-sm font-bold text-soft-white">@tx.AccountName</span>
                                </td>

                                <td class="px-4 py-3">
                                    @if (tx.CategoryName is not null)
                                    {
                                        <span class="text-sm font-medium text-gray-300">@tx.CategoryName</span>
                                    }
                                    else if (tx.IsTransfer)
                                    {
                                        <span class="text-xs font-bold text-vivid-yellow/60 uppercase tracking-wider">transfer</span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-600 text-xs">—</span>
                                    }
                                </td>

                                <td class="px-4 py-3 text-right">
                                    <span class="text-base font-black @AmountColorClass(tx.Type)">
                                        @AmountPrefix(tx.Type)@tx.Amount.ToString("N2")
                                    </span>
                                </td>

                                <td class="px-4 py-3 text-center">
                                    <span class="text-xs font-black uppercase tracking-widest px-2 py-1 border-2 @TypeBadgeClass(tx.Type)">
                                        @tx.Type
                                    </span>
                                </td>

                                <td class="px-4 py-3">
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var tag in tx.Tags.Take(3))
                                        {
                                            <span class="text-xs font-bold px-1.5 py-0.5 border"
                                                  style="border-color: @tag.Color; color: @tag.Color;">
                                                @tag.Name
                                            </span>
                                        }
                                        @if (tx.Tags.Count > 3)
                                        {
                                            <span class="text-xs font-bold text-gray-500">+@(tx.Tags.Count - 3)</span>
                                        }
                                    </div>
                                </td>

                                <td class="px-4 py-3 text-right">
                                    <div class="flex justify-end gap-2">
                                        @if (!tx.IsTransfer)
                                        {
                                            <button @onclick="() => OpenEditModal(tx)"
                                                    class="text-xs font-bold uppercase tracking-widest border-2 border-base-border px-2 py-1
                                                           text-gray-400 hover:border-vivid-yellow hover:text-vivid-yellow transition-colors">
                                                Edit
                                            </button>
                                        }
                                        <button @onclick="() => OpenDeleteModal(tx)"
                                                class="text-xs font-bold uppercase tracking-widest border-2 border-base-border px-2 py-1
                                                       text-gray-400 hover:border-hot-pink hover:text-hot-pink transition-colors">
                                            Del
                                        </button>
                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (_pagination is not null)
            {
                <div class="flex items-center justify-between border-t-2 border-base-border pt-4">
                    <button @onclick="PrevPage"
                            disabled="@(_pagination.CurrentPage <= 1)"
                            class="text-xs font-black uppercase tracking-widest border-2 border-base-border px-4 py-2
                                   text-soft-white hover:border-neon hover:text-neon transition-colors
                                   disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:border-base-border disabled:hover:text-soft-white"
                            style="@(_pagination.CurrentPage > 1 ? "box-shadow: 3px 3px 0px #FFFFFF;" : "")">
                        ← Prev
                    </button>

                    <span class="text-xs font-bold text-gray-400 tracking-widest">
                        Page <span class="text-soft-white">@_pagination.CurrentPage</span>
                        of <span class="text-soft-white">@_pagination.TotalPages</span>
                        &nbsp;·&nbsp;
                        <span class="text-soft-white">@_pagination.TotalItems</span> total
                    </span>

                    <button @onclick="NextPage"
                            disabled="@(_pagination.CurrentPage >= _pagination.TotalPages)"
                            class="text-xs font-black uppercase tracking-widest border-2 border-base-border px-4 py-2
                                   text-soft-white hover:border-neon hover:text-neon transition-colors
                                   disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:border-base-border disabled:hover:text-soft-white"
                            style="@(_pagination.CurrentPage < _pagination.TotalPages ? "box-shadow: 3px 3px 0px #FFFFFF;" : "")">
                        Next →
                    </button>
                </div>
            }
        }
    }
</div>

@if (_showCreateModal)
{
    <CreateTransactionModal Accounts="@_accounts"
                            Categories="@_categories"
                            Tags="@_tags"
                            ExistingTransaction="@_editingTransaction"
                            OnCreated="HandleCreated"
                            OnCancel="CloseCreateModal" />
}

@if (_showDeleteModal && _deleteTarget is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4"
         style="background: rgba(0,0,0,0.88);"
         @onclick="CloseDeleteModal">

        <div class="bg-base-surface border-2 border-hot-pink w-full max-w-sm p-6 space-y-5"
             style="box-shadow: 4px 4px 0px #FF2D78;"
             @onclick:stopPropagation="true">

            <div class="flex items-center justify-between">
                <h2 class="text-2xl font-black uppercase tracking-tight text-hot-pink">Delete</h2>
                <button @onclick="CloseDeleteModal"
                        class="text-gray-500 hover:text-hot-pink font-black text-xl leading-none transition-colors">
                    ✕
                </button>
            </div>

            @if (_deleteError is not null)
            {
                <NeubrutalistAlert Severity="NeubrutalistAlert.AlertSeverity.Error" Message="@_deleteError" />
            }

            <div class="border-2 border-base-border p-4">
                <p class="text-soft-white font-bold">
                    @_deleteTarget.AccountName
                    &nbsp;—&nbsp;
                    <span class="@AmountColorClass(_deleteTarget.Type)">
                        @AmountPrefix(_deleteTarget.Type)@_deleteTarget.Amount.ToString("N2")
                    </span>
                </p>
                <p class="text-xs text-gray-500 mt-1 font-mono">
                    @_deleteTarget.Date.ToString("yyyy-MM-dd")
                    @if (!string.IsNullOrWhiteSpace(_deleteTarget.Notes))
                    {
                        <span> · @_deleteTarget.Notes</span>
                    }
                </p>
            </div>

            @if (_deleteTarget.IsTransfer)
            {
                <p class="text-xs font-bold text-vivid-yellow border-2 border-vivid-yellow/40 p-2">
                    ⚠ This is a transfer. Only this leg will be soft-deleted; the paired transaction will remain.
                </p>
            }

            <p class="text-gray-400 text-sm">
                This transaction will be <span class="font-bold text-soft-white">soft-deleted</span> and the
                account balance will <span class="font-bold text-soft-white">not</span> be automatically reversed.
            </p>

            <div class="flex gap-3 pt-1">
                <NeubrutalistButton Text="@(_deleting ? "Deleting…" : "Yes, Delete")"
                                    Variant="NeubrutalistButton.ButtonVariant.Danger"
                                    Disabled="@_deleting"
                                    OnClick="HandleDelete" />
                <NeubrutalistButton Text="Cancel"
                                    Variant="NeubrutalistButton.ButtonVariant.Ghost"
                                    OnClick="CloseDeleteModal" />
            </div>
        </div>
    </div>
}

@code {
    private List<TransactionListItem> _transactions = [];
    private PaginationMeta? _pagination;
    private bool _loading = true;
    private string? _pageError;

    private IReadOnlyList<AccountModel> _accounts = [];
    private IReadOnlyList<CategoryManagementModel> _categories = [];
    private IReadOnlyList<TagManagementModel> _tags = [];

    private TransactionFilterModel _filter = new();

    private string _filterAccountIdStr
    {
        get => _filter.AccountId.HasValue ? _filter.AccountId.Value.ToString() : "";
        set => _filter.AccountId = Guid.TryParse(value, out var g) ? g : null;
    }
    private string _filterCategoryIdStr
    {
        get => _filter.CategoryId.HasValue ? _filter.CategoryId.Value.ToString() : "";
        set => _filter.CategoryId = Guid.TryParse(value, out var g) ? g : null;
    }
    private string _filterTagIdStr
    {
        get => _filter.TagId.HasValue ? _filter.TagId.Value.ToString() : "";
        set => _filter.TagId = Guid.TryParse(value, out var g) ? g : null;
    }

    private bool _showCreateModal;
    private TransactionDetailModel? _editingTransaction;

    private bool _showDeleteModal;
    private TransactionListItem? _deleteTarget;
    private bool _deleting;
    private string? _deleteError;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadLookupsAsync(), LoadTransactionsAsync());
    }

    private async Task LoadLookupsAsync()
    {
        _accounts = await AccountService.GetAccountsAsync();
        _categories = await CategoryService.GetCategoriesAsync();
        _tags = await TagService.GetTagsAsync();
    }

    private async Task LoadTransactionsAsync()
    {
        _pageError = null;
        _loading = true;
        try
        {
            var (items, pagination) = await TransactionService.GetPagedAsync(_filter);
            _transactions = items;
            _pagination = pagination;
        }
        catch (Exception ex)
        {
            _pageError = $"Failed to load transactions: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApplyFilters()
    {
        _filter.Page = 1;
        await LoadTransactionsAsync();
    }

    private async Task ClearFilters()
    {
        _filter = new TransactionFilterModel();
        await LoadTransactionsAsync();
    }

    private async Task PrevPage()
    {
        if (_pagination is null || _filter.Page <= 1) return;
        _filter.Page--;
        await LoadTransactionsAsync();
    }

    private async Task NextPage()
    {
        if (_pagination is null || _filter.Page >= _pagination.TotalPages) return;
        _filter.Page++;
        await LoadTransactionsAsync();
    }

    private void OpenCreateModal()
    {
        _editingTransaction = null;
        _showCreateModal = true;
    }

    private async Task OpenEditModal(TransactionListItem tx)
    {
        _editingTransaction = await TransactionService.GetByIdAsync(tx.Id);
        _showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        _showCreateModal = false;
        _editingTransaction = null;
    }

    private async Task HandleCreated()
    {
        _showCreateModal = false;
        _editingTransaction = null;
        _filter.Page = 1;
        await LoadTransactionsAsync();
    }

    private void OpenDeleteModal(TransactionListItem tx)
    {
        _deleteTarget = tx;
        _showDeleteModal = true;
        _deleteError = null;
    }

    private void CloseDeleteModal()
    {
        _showDeleteModal = false;
        _deleteTarget = null;
        _deleteError = null;
    }

    private async Task HandleDelete()
    {
        if (_deleteTarget is null) return;
        _deleting = true;
        _deleteError = null;
        try
        {
            var ok = await TransactionService.DeleteAsync(_deleteTarget.Id);
            if (ok)
            {
                _transactions.Remove(_deleteTarget);
                _showDeleteModal = false;
                _deleteTarget = null;
                await LoadTransactionsAsync();
            }
            else
            {
                _deleteError = "Failed to delete. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _deleteError = ex.Message;
        }
        finally
        {
            _deleting = false;
        }
    }

    private static string AmountColorClass(string type) => type switch
    {
        "Income"   => "text-neon",
        "Expense"  => "text-hot-pink",
        "Transfer" => "text-vivid-yellow",
        _          => "text-soft-white"
    };

    private static string AmountPrefix(string type) => type switch
    {
        "Income"   => "+",
        "Expense"  => "-",
        "Transfer" => "→ ",
        _          => ""
    };

    private static string TypeBadgeClass(string type) => type switch
    {
        "Income"   => "border-neon text-neon",
        "Expense"  => "border-hot-pink text-hot-pink",
        "Transfer" => "border-vivid-yellow text-vivid-yellow",
        _          => "border-base-border text-gray-400"
    };
}
