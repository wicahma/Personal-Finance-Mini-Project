@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Forgot password confirmation</PageTitle>

<div class="bg-base-surface border-2 border-base-border shadow-brutal-pink p-8 text-center">
    <div class="text-hot-pink text-4xl font-black mb-4">&#9993;</div>
    <h1 class="text-xl font-black uppercase tracking-widest text-soft-white mb-3">Check your email</h1>
    <p class="text-gray-400 text-sm mb-6" role="alert">
        Please check your inbox for a password reset link.
    </p>
    <a href="Account/Login" class="inline-block border-2 border-base-border text-soft-white font-bold uppercase tracking-widest py-2 px-6 hover:border-soft-white hover:shadow-brutal-white hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-100 text-sm">
        &larr; Back to sign in
    </a>
</div>
