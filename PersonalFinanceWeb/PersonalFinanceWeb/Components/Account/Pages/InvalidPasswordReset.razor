@page "/Account/InvalidPasswordReset"

<PageTitle>Invalid password reset</PageTitle>

<div class="bg-base-surface border-2 border-hot-pink shadow-brutal-pink p-8 text-center">
    <div class="text-hot-pink text-4xl font-black mb-4">&#128274;</div>
    <h1 class="text-xl font-black uppercase tracking-widest text-hot-pink mb-3">Invalid reset link</h1>
    <p class="text-gray-400 text-sm mb-6" role="alert">
        The password reset link is invalid or has expired.
    </p>
    <a href="Account/ForgotPassword" class="inline-block border-2 border-hot-pink text-hot-pink font-bold uppercase tracking-widest py-2 px-6 hover:shadow-brutal-pink hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-100 text-sm">
        &larr; Request a new link
    </a>
</div>
